{
    "$schema": "https://json.schemastore.org/tsconfig",
    "extends": "../tsconfig.json",
    "compilerOptions": {
        "allowJs": true,
        "allowImportingTsExtensions": true,
        "checkJs": false,
        "declaration": false,
        "declarationMap": false,
        "exactOptionalPropertyTypes": false,
        "lib": ["ES2022", "DOM"],
        "noEmit": true,
        "noImplicitAny": false,
        "noImplicitOverride": false,
        "noImplicitReturns": false,
        "noUncheckedIndexedAccess": false,
        "noUnusedLocals": false,
        "noUnusedParameters": false,
        "rootDir": "..",
        "sourceMap": false,
        "strict": true,
        "target": "ES2022",
        "types": ["node"]
    },
    "include": ["**/*.test.ts", "helpers/**/*.mjs"],
    "exclude": [
        "browser/**",
        "codemod/fixtures/**",
        "fixtures/**",
        "package/external-plugin/**",
        "package/reference-consumer/**",
        "types/**"
    ]
}
